<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_equipment_loan_user" model="res.groups">
        <field name="name">Equipment Loan: User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_equipment_loan_manager" model="res.groups">
        <field name="name">Equipment Loan: Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_equipment_loan_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_equipment_loan_manager'))]"/>
    </record>

</odoo>